        "file": "CLAUDE.md",
        "anchor": "Communication Style"
      },
      "enforcement": "prose",
      "hard": false,
      "detector": "user-correction",
      "added": "2026-09-20",
      "last_triggered": null,
      "last_changed": null
    },
    {
      "id": "defect",
      "title": "A fix commit landing on a file a recent change touched: the guardrails missed a defect",
      "source": {
        "file": ".claude/hooks/defect-warn.py",
        "anchor": "defect-warn"
      },
      "enforcement": "hook-warn",
      "hard": false,
      "detector": "defect",
      "added": "2026-09-20",
      "last_triggered": null,
      "last_changed": "2026-09-25"
    }
  ],
  "thresholds": {
    "deterministic_events": 3,
    "deterministic_sessions": 2,
    "heuristic_events": 5,
    "heuristic_sessions": 3,
    "prune_sessions": 10,
    "instruction_token_budget": 8000,
    "retro_prompt_min_sessions": 3,
    "bootstrap_min_archives": 10,
    "defect_lookback_days": 14,
    "escalate_ignored_rate": 0.5
  },
  "correction_patterns": [
    {
      "id": "no",
      "regex": "^\\s*no[,.! ]",
      "enabled": true
    },
    {
      "id": "i-said",
      "regex": "\\bI said\\b",
      "enabled": true
    },
    {
      "id": "again",
      "regex": "\\bagain\\b",
      "enabled": true
    },
    {
      "id": "stop",
      "regex": "\\bstop\\b",
      "enabled": true
    },
    {
      "id": "wrong",
      "regex": "\\bwrong\\b",
      "enabled": true
    },
    {
      "id": "not-what-i",
      "regex": "\\bnot what I\\b",
      "enabled": true
    }
  ],
  "retention": {
    "max_sessions": 500
  },
  "ignore_session_prefixes": [
    "11111111-aaaa-4bbb-8ccc-"
  ],
