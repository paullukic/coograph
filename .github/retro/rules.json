{
  "version": 1,
  "seed_version": 1,
  "rules": [
    {
      "id": "graph-first",
      "title": "Code-graph first: query the graph before Grep/Glob",
      "source": {"file": "CLAUDE.md", "anchor": "HARD RULE, CODE-GRAPH FIRST"},
      "enforcement": "prose",
      "hard": true,
      "detector": "graph-first",
      "added": "2026-09-19",
      "last_triggered": null,
      "last_changed": null
    },
    {
      "id": "openspec-gate",
      "title": "OpenSpec or stop: 2+ file changes need an approved proposal",
      "source": {"file": "CLAUDE.md", "anchor": "HARD RULE, OPENSPEC OR STOP"},
      "enforcement": "prose",
      "hard": true,
      "detector": "openspec-gate",
      "added": "2026-09-19",
      "last_triggered": null,
      "last_changed": null
    },
    {
      "id": "scope",
      "title": "Edits stay inside the active OpenSpec's tasks.md file list",
      "source": {"file": ".claude/hooks/warn-scope.py", "anchor": "warn-scope"},
      "enforcement": "hook-warn",
      "hard": false,
      "detector": "scope-warning",
      "added": "2026-09-19",
      "last_triggered": null,
      "last_changed": null
    },
    {
      "id": "generated-files",
      "title": "Never hand-edit generated files",
      "source": {"file": ".claude/hooks/block-generated.py", "anchor": "block-generated"},
      "enforcement": "hook-block",
      "hard": false,
      "detector": "generated-file-block",
      "added": "2026-09-19",
      "last_triggered": null,
      "last_changed": null
    },
    {
      "id": "no-new-deps",
      "title": "No new dependencies without explicit user approval",
      "source": {"file": "CLAUDE.md", "anchor": "Critical Rules"},
      "enforcement": "prose",
      "hard": false,
      "detector": "new-dependency",
      "added": "2026-09-19",
      "last_triggered": null,
      "last_changed": null
    },
    {
      "id": "preserve-features",
      "title": "Preserve all existing features unless the ticket says remove",
      "source": {"file": ".github/copilot-instructions.md", "anchor": "Implementation Safety"},
      "enforcement": "prose",
      "hard": false,
      "detector": null,
      "added": "2026-09-19",
      "last_triggered": null,
      "last_changed": null
    }
  ],
  "thresholds": {
    "deterministic_events": 3,
    "deterministic_sessions": 2,
    "heuristic_events": 5,
    "heuristic_sessions": 3,
    "prune_sessions": 10,
    "instruction_token_budget": 8000,
    "retro_prompt_min_sessions": 3,
    "bootstrap_min_archives": 10
  },
  "correction_patterns": [
    {"id": "no", "regex": "^\\s*no[,.! ]", "enabled": true},
    {"id": "i-said", "regex": "\\bI said\\b", "enabled": true},
    {"id": "again", "regex": "\\bagain\\b", "enabled": true},
    {"id": "stop", "regex": "\\bstop\\b", "enabled": true},
    {"id": "wrong", "regex": "\\bwrong\\b", "enabled": true},
    {"id": "not-what-i", "regex": "\\bnot what I\\b", "enabled": true}
  ],
  "retention": {"max_sessions": 500},
  "last_retro": null
}
