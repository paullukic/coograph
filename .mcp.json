{
  "mcpServers": {
    "code-graph": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-p",
        ">=3.10",
        "--with-requirements",
        ".github/code-graph/requirements.txt",
        ".github/code-graph/server.py"
      ],
      "env": {
        "UV_NO_MANAGED_PYTHON": "1",
        "UV_PYTHON_DOWNLOADS": "never"
      }
    }
  }
}
